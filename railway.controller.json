{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "uv sync"
  },
  "deploy": {
    "startCommand": "uv run local_launcher.py launch controller --port $PORT --host 0.0.0.0 --green-url $GREEN_AGENT_URL --white-url $WHITE_AGENT_URL",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
